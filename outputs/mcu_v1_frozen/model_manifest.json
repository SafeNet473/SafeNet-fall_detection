        0.8870329996526946
      ]
    ],
    "initialization": "sosfilt_zi(SOS)[:,:,None] * first_raw_acceleration_g[None,None,:]",
    "state_reset": "only at independent trial start; never per trigger/window",
    "state_dtype": "float64",
    "filtered_sample_interface": "cast float32 then float64 before derived scalar calculations",
    "section_update": [
      "y=b0*x+z1",
