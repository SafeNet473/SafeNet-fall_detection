  "gravity": {
    "input": "raw unfiltered acceleration in g",
    "alpha": 0.01558523664828626,
    "nominal_cutoff_hz": 0.5,
    "alpha_definition": "1-exp(-2*pi*0.5/200)",
    "equation": "G[t]=alpha*r[t]+(1-alpha)*G[t-1]",
    "initialization": "G[-1]=r[0]",
    "state_reset": "trial start only",
    "state_dtype": "float64",
    "normalization_floor_g": 1e-08,
    "unit_equation": "u=G/max(sqrt(G dot G),1e-8)"
  },
  "derived_streams": {
    "m": "sqrt(a dot a)",
    "p": "a dot u (signed)",
    "b": "a-p*u",
    "h": "sqrt(b dot b)",
    "dtype": "float64"
  },
  "trigger": {
    "magnitude_g": 1.1,
    "absolute_magnitude_jerk_g_per_s": 5.0,
    "jerk": "j[t]=200*abs(m[t]-m[t-1]); j[0]=0",
    "condition": "H[t]=(m[t]>=1.1) OR (j[t]>=5.0)",
    "edge": "H[t] AND NOT H[t-1]",
    "initial_high": false,
    "refractory_samples": 300,
    "refractory_seconds": 1.5,
    "accepted_when": "rising edge AND t-last_accepted_trigger>=300",
    "initial_last_accepted_trigger": -300,
    "refractory_edges": "discard, do not queue; staying high does not retrigger",
    "incomplete_window_trigger": "accepted trigger still updates refractory state"
  },
  "window": {
    "name": "pre100_post200",
